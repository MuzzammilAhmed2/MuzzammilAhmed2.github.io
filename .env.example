# Copy to .env.local and fill in. In production these come from GitHub repo variables (see README).

# Live URL, used for canonical links, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://muzzammilahmed2.github.io

# Formspree form ID: the part after /f/ in https://formspree.io/f/xxxxxxx
# Leave empty and the contact form opens the visitor's email app instead (with a visible note).
NEXT_PUBLIC_FORMSPREE_ID=

# Cloudflare Web Analytics beacon token. Leave empty to load no analytics.
NEXT_PUBLIC_CF_BEACON_TOKEN=
