# Copy to .env.local and fill in.

# Your live URL (used for SEO, sitemap and Open Graph). Set this in Vercel too.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Formspree form ID — the part after /f/ in https://formspree.io/f/xxxxxxx
# Leave empty and the contact form falls back to opening the visitor's email app.
NEXT_PUBLIC_FORMSPREE_ID=
